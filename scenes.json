  {
    "id": "scene_29",
    "type": "image",
    "asset": "assets/images_enhanced/37_tanker_flags_tearing_tug_of_war.jpg",
    "text": "And the consequences are not limited to America's foreign policy.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_2_1793835656984.wav",
