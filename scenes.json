    "id": "scene_24",
    "type": "video",
    "asset": "assets/video/dod_carrier_night_ops.mp4",
    "text": "For months, the United States has been caught in a dangerous confrontation with Iran.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_2_1793835656984.wav",
