  },
  {
    "id": "scene_20",
    "type": "image",
    "asset": "assets/images_enhanced/41_trump_marine_one_chopper_talk.jpg",
    "text": "But governing America could become considerably more difficult.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_3_1793835656984.wav",
