    "audio_file": "assets/audio/segments/scene_18.wav"
  },
  {
    "id": "scene_19",
    "type": "image",
    "asset": "assets/images_enhanced/17_trump_red_carpet_hallway_alone.jpg",
    "text": "Trump will still be president.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_3_1793835656984.wav",
