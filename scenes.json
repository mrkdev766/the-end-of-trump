  {
    "id": "scene_12",
    "type": "video",
    "asset": "assets/titles/date_scene_12.mp4",
    "text": "November 3, 2026. America's midterm elections delivered a major political setback for Donald Trump.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_3_1793835656984.wav",
