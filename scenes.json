  },
  {
    "id": "scene_32",
    "type": "image",
    "asset": "assets/images_enhanced/26_khamenei_irgc_generals_salute.jpg",
    "text": "Trump has repeatedly suggested that the conflict could end soon.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_2_1793835656984.wav",
