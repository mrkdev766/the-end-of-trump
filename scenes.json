  {
    "id": "scene_30",
    "type": "image",
    "asset": "assets/images_enhanced/24_trump_briefing_room_podium_blue_tie.jpg",
    "text": "They are increasingly becoming a domestic political issue for Trump.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_2_1793835656984.wav",
