    "audio_file": "assets/audio/segments/scene_13.wav"
  },
  {
    "id": "scene_14",
    "type": "image",
    "asset": "assets/images_enhanced/12_empty_committee_hearing_dais.jpg",
    "text": "And this matters far more than just losing an election.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_3_1793835656984.wav",
