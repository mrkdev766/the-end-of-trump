    "type": "image",
    "asset": "assets/images_enhanced/05_capitol_lightning_night.jpg",
    "text": "His party has suffered a major setback in Congress.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_4_1793835656984.wav",
