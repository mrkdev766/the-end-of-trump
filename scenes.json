    "type": "image",
    "asset": "assets/images_enhanced/21_strait_of_hormuz_tankers_aerial.jpg",
    "text": "One of the biggest concerns is the Strait of Hormuz.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_2_1793835656984.wav",
