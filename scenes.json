    "audio_file": "assets/audio/segments/scene_16.wav"
  },
  {
    "id": "scene_17",
    "type": "image",
    "asset": "assets/images_enhanced/05_capitol_lightning_night.jpg",
    "text": "But that political advantage has now changed.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_3_1793835656984.wav",
    "slice": [
      30.27,
