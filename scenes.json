    "audio_file": "assets/audio/segments/scene_21.wav"
  },
  {
    "id": "scene_22",
    "type": "image",
    "asset": "assets/images_enhanced/20_orbital_strike_escalation_map.jpg",
    "text": "It's thousands of miles away, in Iran.",
    "audio_src": "/home/rashid/.gemini/antigravity/scratch/trump-iran-doc/assets/audio/user_narration/uploaded_media_3_1793835656984.wav",
